# Paletto agent + Backend Hub server-side artifacts.
# .paletto: server-only credentials (.paletto/baas.env, chmod 600). NEVER commit.
# .paletto-agent: agent skill files materialized at runtime, not source code.
.paletto/
.paletto-agent/

# pnpm in-container installs fall back to a project-local store (bind-mounted
# project sits on a different filesystem than the default store); tens of
# thousands of files here must never enter git status or agent snapshots.
.pnpm-store/

